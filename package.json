{
  "name": "@lixiangzhong/dsh-active-chat",
  "version": "0.1.0",
  "description": "Pin workspaces whose sessions are running or waiting for your reply to the top of the DSH sidebar.",
  "author": "lixiangzhong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixiangzhong/dsh-active-chat.git"
  },
  "homepage": "https://github.com/lixiangzhong/dsh-active-chat#readme",
  "bugs": {
    "url": "https://github.com/lixiangzhong/dsh-active-chat/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --check index.js && node --check client.js && node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "sidebar",
    "workspace",
    "session"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  }
}
